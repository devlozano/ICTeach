RewriteEngine On

# Redirect the apex hostname to the canonical www deployment.
RewriteCond %{HTTP_HOST} ^icteach\.ipeso\.website$ [NC]
RewriteRule ^ https://www.icteach.ipeso.website%{REQUEST_URI} [R=301,L,NE]

# Revalidate Flutter entry files after every deployment.
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|flutter_bootstrap\.js|flutter_service_worker\.js|main\.dart\.js|version\.json)$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
</IfModule>

# Support Flutter client-side routes.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
