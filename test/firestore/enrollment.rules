// ENROLLMENT-ONLY PROTOTYPE. Not a drop-in production LMS ruleset.
// Schemas and rollout gates: docs/ENROLLMENT_SECURITY_ANALYSIS.md.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function issuer() {
      return request.auth != null &&
        get(/databases/$(database)/documents/registration_issuers/$(request.auth.uid)).data.enabled == true;
    }
    function text(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function key(v) { return v is string && v.matches('^[a-f0-9]{64}$'); }
    function lrn(v) { return v is string && v.matches('^[0-9]{12}$'); }
    function validMaster(d) {
      return d.keys().hasOnly(['firstName','lastName','middleName','uploadedAt',
          'isRegistered','invitationId','registeredUid','registeredAt']) &&
        text(d.firstName, 1, 150) && text(d.lastName, 1, 150) &&
        (!('middleName' in d) || text(d.middleName, 0, 150)) &&
        d.uploadedAt is timestamp && d.isRegistered is bool &&
        (!('invitationId' in d) || key(d.invitationId)) &&
        (d.isRegistered
          ? text(d.registeredUid, 1, 128) && d.registeredAt is timestamp
          : !d.keys().hasAny(['registeredUid','registeredAt']));
    }
    function validProfile(d, uid) {
      return d.keys().hasOnly(['uid','lrn','firstName','middleName','lastName',
          'extension','displayName','name','email','role','createdAt','updatedAt',
          'registrationInvitationId']) &&
        d.uid == uid && lrn(d.lrn) && d.role == 'student' &&
        text(d.firstName,1,150) && text(d.lastName,1,150) &&
        text(d.middleName,0,150) && text(d.extension,0,30) &&
        text(d.displayName,1,500) && d.name == d.displayName &&
        text(d.email,3,320) && d.createdAt is timestamp && d.updatedAt is timestamp &&
        key(d.registrationInvitationId);
    }
    function eligible(id, number) {
      return key(id) && lrn(number) &&
        get(/databases/$(database)/documents/registration_bindings/$(id)).data.lrn == number &&
        get(/databases/$(database)/documents/registration_checks/$(id)).data.expiresAt > request.time &&
        get(/databases/$(database)/documents/lrn_master_list/$(number)).data.isRegistered == false &&
        get(/databases/$(database)/documents/lrn_master_list/$(number)).data.invitationId == id;
    }
    function claimed(uid, number, id) {
      let p = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      let m = getAfter(/databases/$(database)/documents/lrn_master_list/$(number)).data;
      return validProfile(p,uid) && p.lrn == number && p.registrationInvitationId == id &&
        getAfter(/databases/$(database)/documents/students/$(uid)).data == p &&
        m.isRegistered == true && m.registeredUid == uid && m.registeredAt == request.time &&
        !existsAfter(/databases/$(database)/documents/registration_checks/$(id));
    }
    function newProfile(d, uid) {
      return owner(uid) && validProfile(d,uid) &&
        d.email == request.auth.token.email &&
        d.createdAt == request.time && d.updatedAt == request.time &&
        !exists(/databases/$(database)/documents/users/$(uid)) &&
        !exists(/databases/$(database)/documents/students/$(uid)) &&
        eligible(d.registrationInvitationId,d.lrn) &&
        claimed(uid,d.lrn,d.registrationInvitationId);
    }
    match /registration_issuers/{uid} {
      allow get: if owner(uid);
      allow write, list: if false;
    }
    match /registration_checks/{id} {
      // Explicit capability-based pre-account check. Contains only expiry.
      allow get: if key(id);
      allow list, update: if false;
      allow create: if issuer() && key(id) &&
        request.resource.data.keys().hasOnly(['expiresAt']) &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt <= request.time + duration.value(8,'d') &&
        getAfter(/databases/$(database)/documents/lrn_master_list/$(getAfter(/databases/$(database)/documents/registration_bindings/$(id)).data.lrn)).data.invitationId == id;
      allow delete: if issuer() || (request.auth != null &&
        eligible(id,get(/databases/$(database)/documents/registration_bindings/$(id)).data.lrn) &&
        claimed(request.auth.uid,get(/databases/$(database)/documents/registration_bindings/$(id)).data.lrn,id));
    }
    match /registration_bindings/{id} {
      allow read, delete: if issuer();
      allow update: if false;
      allow create: if issuer() && key(id) &&
        request.resource.data.keys().hasOnly(['lrn']) && lrn(request.resource.data.lrn) &&
        getAfter(/databases/$(database)/documents/lrn_master_list/$(request.resource.data.lrn)).data.invitationId == id &&
        getAfter(/databases/$(database)/documents/lrn_master_list/$(request.resource.data.lrn)).data.isRegistered == false;
    }
    match /lrn_master_list/{number} {
      allow read: if issuer();
      allow create: if issuer() && lrn(number) && validMaster(request.resource.data) &&
        request.resource.data.isRegistered == false &&
        request.resource.data.uploadedAt == request.time &&
        !request.resource.data.keys().hasAny(['invitationId']);
      allow update: if lrn(number) && validMaster(request.resource.data) && (
        (issuer() && resource.data.isRegistered == false &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invitationId'])) ||
        (request.auth != null &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isRegistered','registeredUid','registeredAt']) &&
          eligible(resource.data.invitationId,number) &&
          claimed(request.auth.uid,number,resource.data.invitationId))
      );
      allow delete: if false;
    }
    match /users/{uid} {
      allow get: if owner(uid);
      allow create: if newProfile(request.resource.data,uid);
      allow update: if owner(uid) && validProfile(request.resource.data,uid) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['firstName','middleName','lastName','extension','displayName','name','updatedAt']) &&
        request.resource.data.updatedAt == request.time;
    }
    match /students/{uid} {
      allow get: if owner(uid);
      allow create: if newProfile(request.resource.data,uid);
      allow update: if owner(uid) && validProfile(request.resource.data,uid) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['firstName','middleName','lastName','extension','displayName','name','updatedAt']) &&
        request.resource.data.updatedAt == request.time;
    }
  }
}
